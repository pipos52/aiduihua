<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Dark theme fits a "novel chat" app -->
    <style name="Theme.NovelChat" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
    </style>

    <style name="ChatBubbleUser">
        <item name="android:background">@drawable/bg_bubble_user</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="ChatBubbleBot">
        <item name="android:background">@drawable/bg_bubble_bot</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
